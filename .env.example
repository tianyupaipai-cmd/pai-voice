# Never commit real credentials or private endpoints.
PAIVOICE_ASR_PROVIDER=mock
PAIVOICE_TTS_PROVIDER=mock
PAIVOICE_ADAPTER=mock

# Provider keys belong only in the deployment environment, never in browser
# JavaScript, a mobile build, screenshots, issues, logs, or this repository.
# Use independent, restricted keys for ASR and TTS where your provider allows it.
PAIVOICE_ASR_API_KEY=
PAIVOICE_TTS_API_KEY=

# Examples only: supply these locally when a provider requires them.
# OPENAI_API_KEY=
# GROQ_API_KEY=
# ELEVENLABS_API_KEY=
