# Never commit real credentials or private endpoints.
PAIVOICE_ASR_PROVIDER=mock
PAIVOICE_TTS_PROVIDER=mock
PAIVOICE_ADAPTER=mock

# Provider keys belong only in the deployment environment, never in browser
# JavaScript, a mobile build, screenshots, issues, logs, or this repository.
# Use independent, restricted keys for ASR and TTS where your provider allows it.
PAIVOICE_ASR_API_KEY=
PAIVOICE_TTS_API_KEY=

# Examples only: supply these locally when a provider requires them.
# OPENAI_API_KEY=
# GROQ_API_KEY=
# ELEVENLABS_API_KEY=

# 视频通话（可选）：视觉模型链，逗号分隔的名字，每个名字按 PAIVOICE_VISION_<NAME>_* 找配置；缺 key 的自动跳过
PAIVOICE_VISION_BACKENDS=
PAIVOICE_VISION_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
PAIVOICE_VISION_DEEPSEEK_API_KEY=
PAIVOICE_VISION_DEEPSEEK_MODEL=deepseek-flash
PAIVOICE_VISION_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PAIVOICE_VISION_QWEN_API_KEY=
# qwen3-vl-flash 已下架；新一代 qwen3.x-flash 能一次看多张图，便宜，核心会自动关掉它的思考
PAIVOICE_VISION_QWEN_MODEL=qwen3.6-flash
PAIVOICE_VISION_TIMEOUT=12
PAIVOICE_VISION_TOTAL_TIMEOUT=25
# 一起看电影（前端 setWatchTitle 告诉片名后）：一段多少秒、挑几帧、每段最多多少字。一次看 8 张图要十几秒，超时建议放到 30 / 40
PAIVOICE_FILM_STORY_SECONDS=60
PAIVOICE_FILM_STORY_FRAMES=8
PAIVOICE_FILM_MAX_CHARS=400
PAIVOICE_EYE_FILE=/tmp/paivoice-eye-latest.jpg
# 陪伴模式（秒）：离开多久算走了 / 离开·回来·小动作共用冷却 / 多久没动静提醒喝水·站立 / 模型最少·保底间隔
PAIVOICE_COMPANION_ABSENT_SECONDS=120
PAIVOICE_COMPANION_NUDGE_SECONDS=120
PAIVOICE_COMPANION_STILL_SECONDS=1800
# 屏幕共享：每几秒把这段的几帧按顺序一起交给视觉模型串一次（模型要能一次看多张图）
PAIVOICE_SCREEN_STORY_SECONDS=10
PAIVOICE_SCREEN_STORY_FRAMES=5
PAIVOICE_COMPANION_ASSESS_MIN_SECONDS=60
PAIVOICE_COMPANION_ASSESS_MAX_SECONDS=300
# 断线接回：连接断了先留着这一通多少秒，网页端在这期间自动重连、接着同一通
PAIVOICE_RESUME_SECONDS=60
